APP_NAME="St. Mark SMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@stmarksms.com
MAIL_FROM_NAME="${APP_NAME}"

# Chapa Payment Gateway (Ethiopia)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=

# Ollama AI (not available on Railway - leave blank)
OLLAMA_MODEL=tinyllama
OLLAMA_URL=http://127.0.0.1:11434

# Google Calendar Integration
GOOGLE_CALENDAR_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=google-service-account.json
GOOGLE_CALENDAR_ID=primary
